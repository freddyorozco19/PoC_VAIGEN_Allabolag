# Copiar a .env.local y rellenar cuando existan las credenciales.
# Bolagsverket está implementado (sin probar contra el API real); SCB sigue siendo
# un stub (ver src/lib/data-sources/README.md). Sin credenciales la app usa solo
# los datos de EJEMPLO.

# Bolagsverket — API gratuito "värdefulla datamängder"
# Las claves llegan en un ZIP cifrado (client id y client secret, una por línea); el código
# para abrirlo llega en un correo aparte. Hay claves distintas para test y para producción.
# Una cuenta inactiva se cierra a los 6 meses.
BOLAGSVERKET_CLIENT_ID=
BOLAGSVERKET_CLIENT_SECRET=
# URL base del API, sin barra final. Según los correos de "Anslutningsuppgifter":
#   test (empieza por aquí):  https://gw-accept2.api.bolagsverket.se/vardefulla-datamangder/v1
#   producción:               https://gw.api.bolagsverket.se/vardefulla-datamangder/v1
BOLAGSVERKET_BASE_URL=
# Opcional. Se deduce de la URL base (gw → portal):
#   test: https://portal-accept2.api.bolagsverket.se/oauth2/token
#   producción: https://portal.api.bolagsverket.se/oauth2/token
BOLAGSVERKET_TOKEN_URL=

# SCB — estadísticas abiertas (medianas del sector). Funciona SIN configurar nada.
# Solo para cambiar el comportamiento por defecto:
#   SCB_STATS_DISABLED=1                  # no llamar a SCB; usar las medianas de EJEMPLO
#   SCB_STATS_BASE_URL=https://statistikdatabasen.scb.se/api/v2

# SCB — Företagsregistret
# Requiere solicitar acceso a scbforetag@scb.se
SCB_API_KEY=
SCB_BASE_URL=
